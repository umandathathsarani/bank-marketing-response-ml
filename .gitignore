# Data
# We don't commit data files to avoid bloating the repo and potential data safety issues
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Models and outputs
models/
*.pkl
*.model
*.joblib
*.h5
*.hdf5

# Credentials and secrets
*.pem
*.key
.env
secret/
